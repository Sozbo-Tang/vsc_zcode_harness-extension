{
  "name": "zcode-py",
  "displayName": "Zcode-Py",
  "description": "Python agent harness in a VSCode sidebar (TS thin shell + Python core over stdio JSONL)",
  "version": "0.1.0",
  "publisher": "zcode-py",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "//extensionKind": "spawn 工作区侧 Python、读工作区文件 → 必须是 workspace 扩展（远程开发跑在远程扩展宿主，见 docs/research/vscode-integration.md §6.1）",
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zcode-py",
          "title": "Zcode-Py",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "zcode-py": [
        {
          "type": "webview",
          "id": "zcode.sidebar",
          "name": "Zcode-Py"
        }
      ]
    },
    "commands": [
      {
        "command": "zcode.newSession",
        "title": "Zcode-Py: New Session",
        "icon": "$(add)"
      },
      {
        "command": "zcode.stopGeneration",
        "title": "Zcode-Py: Stop Generation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "zcode.openSidebar",
        "title": "Zcode-Py: Open Sidebar"
      },
      {
        "command": "zcode.apiSettings",
        "title": "Zcode-Py: API Settings"
      },
      {
        "command": "zcode.openSettings",
        "title": "Zcode-Py: Open Settings"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zcode.newSession",
          "group": "navigation",
          "when": "view == zcode.sidebar"
        },
        {
          "command": "zcode.stopGeneration",
          "group": "navigation",
          "when": "view == zcode.sidebar"
        }
      ]
    },
    "configuration": {
      "title": "Zcode-Py",
      "properties": {
        "zcode-py.inlineCompletion.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "内联补全（幽灵文本）默认关闭（R13）；M9 提供实现。"
        }
      }
    }
  }
}
